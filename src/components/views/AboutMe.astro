---
import { aboutMe } from "../../data/AboutMe";
import { User } from "lucide-react";
---

<div id="about-me">
  <h1>Sobre mi</h1>
  <h3><User /> Alejandro Bravo Lingyte</h3>
  <!-- Uso un map porqué es mas facil actualizar elementos -->
  <div class="data-list">
    <ul>
      {aboutMe.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>

<style>
  /* Cambiado de .about-me a #about-me */
  #about-me {
    padding: 2rem 5%;
  }

  #about-me h1,
  #about-me h3 {
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    color: var(--text-color);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
    gap: 20px;
  }

  #about-me h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }

  #about-me h3 {
    font-size: 1.5rem;
    margin-top: 2rem;
  }

  .data-list {
    background-color: var(--accent-2);
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .data-list li {
    margin-bottom: 0.75rem;
    line-height: 1.2;
    font-size: large;
    color: var(--text-color);
    font-family: Arial, Helvetica, sans-serif;
  }
</style>
