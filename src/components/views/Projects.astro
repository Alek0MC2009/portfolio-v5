---
import ProjectCard from "../common/ProjectCard.astro";
import { ProjectsList } from "../../data/Projects";
---

<section class="projects-section">
  <h2>Mis Proyectos</h2>

  <div class="projects-grid">
    {/* ✅ Pasa el objeto project directamente */}
    {ProjectsList.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .projects-section {
    font-family: arial;
  }
  .projects-section h2 {
    text-align: center;
    color: var(--text-color);
    margin-bottom: 2rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    padding: 0 5%;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 1rem;
    }
  }
</style>
